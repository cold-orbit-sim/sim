[sub_resource type="Shader" id="Shader_1"]
code = "shader_type spatial;
render_mode unshaded;

uniform float checker_scale = 4.0;

void fragment() {
	vec2 cell = floor(UV * checker_scale);
	bool white = mod(cell.x + cell.y, 2.0) < 1.0;
	ALBEDO = white ? vec3(1.0, 1.0, 1.0) : vec3(1.0, 0.05, 0.05);
}
"

